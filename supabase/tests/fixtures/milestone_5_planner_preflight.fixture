-- =============================================================================
-- FIXTURE: Milestone 5 Target Grade Planner Preflight Fixture
--
-- File: supabase/tests/fixtures/milestone_5_planner_preflight.fixture
--
-- Purpose:
--   Reusable, non-.sql fixture creating the authentic June 2026 Milestone 5
--   planner catalogue scenario across 13 tables (exactly 135 rows), establishing
--   two synthetic test users, enrolling User 1 across three MVP syllabus routes
--   (Chemistry 9701 AS-only, Physics 9702 Full A-Level, Mathematics 9709 Staged),
--   recording 3 historical attempts for User 1, and establishing a confirmed,
--   approved carry-forward bridge link to Migration 036 evidence.
--
-- Target Catalogue Inventory (Exact 135 Rows Across 13 Tables):
--   1.  grade_threshold_import_runs:                   1 row
--   2.  grade_threshold_publications:                  3 rows (Chem 9701, Phys 9702, Math 9709)
--   3.  grade_threshold_weighting_sources:             3 rows (Chem 9701, Phys 9702, Math 9709)
--   4.  grade_threshold_weighting_entries:            11 rows (3 Chem, 5 Phys, 3 Math)
--   5.  grade_threshold_component_variants:           13 rows (3 Chem, 5 Phys, 5 Math)
--   6.  grade_threshold_component_marks:              65 rows (13 variants x 5 marks A-E)
--   7.  grade_threshold_variant_benchmark_groups:      1 row  (Math P1 Grade A raw max 75)
--   8.  grade_threshold_variant_benchmark_members:     3 rows (Math P1 variants 11, 12, 13)
--   9.  grade_threshold_combinations:                  3 rows (Chem S3, Phys AY, Math DC)
--   10. grade_threshold_combination_tokens:           11 rows (3 Chem S3, 5 Phys AY, 3 Math DC)
--   11. grade_threshold_combination_marks:            17 rows (5 Chem S3, 6 Phys AY, 6 Math DC)
--   12. grade_threshold_combination_carry_forward_links: 1 row (Math DC token 82 -> Migration 036)
--   13. past_papers:                                   3 rows (Chem P1, P2, P3 attempts for User 1)
--   Sum: 1 + 3 + 3 + 11 + 13 + 65 + 1 + 3 + 3 + 11 + 17 + 1 + 3 = 135 rows
--
-- Safety & Concurrency Contracts:
--   - Interrupted-run fail-closed guard: rejects execution if _fixture_m5_preview exists (55000)
--   - Collision pre-check: validates that none of the deterministic fixture IDs exist (23505)
--   - Synthetic user collision pre-check: rejects if synthetic auth users or profiles exist (23505)
--   - Callable routine: pg_temp.apply_m5_planner_preflight_fixture() encapsulates fixture logic
--   - Deferred execution: runs immediately unless m5.defer_fixture_execution is set to 'true'
-- =============================================================================

-- ─── 0. Configuration & Parameters ───────────────────────────────────────────
CREATE TEMP TABLE IF NOT EXISTS pg_temp.m5_planner_fixture_config (
  key      TEXT PRIMARY KEY,
  id_val   UUID,
  text_val TEXT
);

INSERT INTO pg_temp.m5_planner_fixture_config (key, id_val, text_val) VALUES
  ('user_1_id', 'f1870000-0000-4000-8000-000000000001'::UUID, 'm5_student1@example.com'),
  ('user_2_id', 'f1870000-0000-4000-8000-000000000006'::UUID, 'm5_student2@example.com'),
  ('bridge_link_id', 'f1870000-0000-4000-8000-000000000002'::UUID, 'm5-fixture-auditor')
ON CONFLICT (key) DO NOTHING;

-- ─── 1. Fixture Application Routine ──────────────────────────────────────────
CREATE OR REPLACE FUNCTION pg_temp.apply_m5_planner_preflight_fixture()
RETURNS void
LANGUAGE plpgsql
AS $$
DECLARE
  v_u1 UUID;
  v_u2 UUID;
  v_subj_chem UUID := '9dc6d47b-4a83-5220-8c00-14de63eeb9c1';
  v_subj_phys UUID := 'ad6d8dab-a9cc-513e-a45f-383efdb930cb';
  v_subj_math UUID := '07aa2f25-f47d-53a8-bbf7-2a3484fd5896';
  v_us_chem UUID;
  v_us_phys UUID;
  v_us_math UUID;
  v_math_selections JSONB := '[
    {"paper_number": 1, "component_name": "Pure Mathematics 1", "stage": "as"},
    {"paper_number": 4, "component_name": "Mechanics", "stage": "as"},
    {"paper_number": 3, "component_name": "Pure Mathematics 3", "stage": "a2"},
    {"paper_number": 5, "component_name": "Probability & Statistics 1", "stage": "a2"}
  ]'::jsonb;
BEGIN
  SELECT id_val INTO v_u1 FROM pg_temp.m5_planner_fixture_config WHERE key = 'user_1_id';
  SELECT id_val INTO v_u2 FROM pg_temp.m5_planner_fixture_config WHERE key = 'user_2_id';

  -- ── Guardrail 1: Interrupted-run check (fails closed with 55000) ───────────
  IF EXISTS (SELECT 1 FROM pg_namespace WHERE nspname = '_fixture_m5_preview') THEN
    RAISE EXCEPTION 'Interrupted run detected: schema _fixture_m5_preview already exists'
      USING ERRCODE = '55000';
  END IF;

  -- ── Guardrail 2: Deterministic catalogue collisions across all 13 tables ───
  IF EXISTS (SELECT 1 FROM public.grade_threshold_import_runs WHERE id = '00000000-0000-4000-8000-000000000010') THEN
    RAISE EXCEPTION 'Preflight collision: import run 00000000-0000-4000-8000-000000000010 already exists' USING ERRCODE = '23505';
  END IF;

  IF EXISTS (SELECT 1 FROM public.grade_threshold_publications WHERE id IN (
    '00000000-0000-4000-8000-000000000021',
    '00000000-0000-4000-8000-000000000022',
    '00000000-0000-4000-8000-000000000023'
  )) THEN
    RAISE EXCEPTION 'Preflight collision: publication ID already exists' USING ERRCODE = '23505';
  END IF;

  IF EXISTS (SELECT 1 FROM public.grade_threshold_weighting_sources WHERE id IN (
    '00000000-0000-4000-8000-000000000031',
    '00000000-0000-4000-8000-000000000032',
    '00000000-0000-4000-8000-000000000033'
  )) THEN
    RAISE EXCEPTION 'Preflight collision: weighting source ID already exists' USING ERRCODE = '23505';
  END IF;

  IF EXISTS (SELECT 1 FROM public.grade_threshold_weighting_entries WHERE id >= '00000000-0000-4000-8000-000000000041' AND id <= '00000000-0000-4000-8000-00000000004b') THEN
    RAISE EXCEPTION 'Preflight collision: weighting entry ID already exists' USING ERRCODE = '23505';
  END IF;

  IF EXISTS (SELECT 1 FROM public.grade_threshold_component_variants WHERE id >= '00000000-0000-4000-8000-000000000081' AND id <= '00000000-0000-4000-8000-00000000008d') THEN
    RAISE EXCEPTION 'Preflight collision: component variant ID already exists' USING ERRCODE = '23505';
  END IF;

  IF EXISTS (SELECT 1 FROM public.grade_threshold_variant_benchmark_groups WHERE id = '00000000-0000-4000-8000-000000000061') THEN
    RAISE EXCEPTION 'Preflight collision: benchmark group ID already exists' USING ERRCODE = '23505';
  END IF;

  IF EXISTS (SELECT 1 FROM public.grade_threshold_combinations WHERE id IN (
    '00000000-0000-4000-8000-0000000000c1',
    '00000000-0000-4000-8000-0000000000c2',
    '00000000-0000-4000-8000-0000000000c3'
  )) THEN
    RAISE EXCEPTION 'Preflight collision: combination ID already exists' USING ERRCODE = '23505';
  END IF;

  IF EXISTS (SELECT 1 FROM public.grade_threshold_combination_tokens WHERE id >= '00000000-0000-4000-8000-0000000000d1' AND id <= '00000000-0000-4000-8000-0000000000db') THEN
    RAISE EXCEPTION 'Preflight collision: combination token ID already exists' USING ERRCODE = '23505';
  END IF;

  IF EXISTS (SELECT 1 FROM public.grade_threshold_combination_marks WHERE id >= '00000000-0000-4000-8000-0000000000e1' AND id <= '00000000-0000-4000-8000-0000000000f1') THEN
    RAISE EXCEPTION 'Preflight collision: combination mark ID already exists' USING ERRCODE = '23505';
  END IF;

  IF EXISTS (SELECT 1 FROM public.grade_threshold_combination_carry_forward_links WHERE id = 'f1870000-0000-4000-8000-000000000002') THEN
    RAISE EXCEPTION 'Preflight collision: carry-forward link ID f1870000-0000-4000-8000-000000000002 already exists' USING ERRCODE = '23505';
  END IF;

  IF EXISTS (SELECT 1 FROM public.past_papers WHERE id IN (
    'f1870000-0000-4000-8000-000000000003',
    'f1870000-0000-4000-8000-000000000004',
    'f1870000-0000-4000-8000-000000000005'
  )) THEN
    RAISE EXCEPTION 'Preflight collision: past paper attempt ID already exists' USING ERRCODE = '23505';
  END IF;

  -- ── Guardrail 3: Synthetic Auth Users & Profiles Collision Pre-Checks ──────
  IF EXISTS (SELECT 1 FROM auth.users WHERE id IN (v_u1, v_u2)) THEN
    RAISE EXCEPTION 'Preflight collision: synthetic auth user % already exists',
      (SELECT id FROM auth.users WHERE id IN (v_u1, v_u2) LIMIT 1)
      USING ERRCODE = '23505';
  END IF;

  IF EXISTS (SELECT 1 FROM auth.users WHERE email IN ('m5_student1@example.com', 'm5_student2@example.com')) THEN
    RAISE EXCEPTION 'Preflight collision: synthetic auth user email % already exists',
      (SELECT email FROM auth.users WHERE email IN ('m5_student1@example.com', 'm5_student2@example.com') LIMIT 1)
      USING ERRCODE = '23505';
  END IF;

  IF EXISTS (SELECT 1 FROM public.profiles WHERE id IN (v_u1, v_u2) OR username IN ('m5_student1', 'm5_student2') OR email IN ('m5_student1@example.com', 'm5_student2@example.com')) THEN
    RAISE EXCEPTION 'Preflight collision: synthetic profile ID, username, or email already exists'
      USING ERRCODE = '23505';
  END IF;

  -- ── 2. Synthetic Test Users & Route Enrollment ─────────────────────────────
  -- Fail-closed direct inserts without ON CONFLICT DO NOTHING
  INSERT INTO auth.users (id, email, raw_user_meta_data) VALUES
    (v_u1, 'm5_student1@example.com', '{"full_name": "M5 Student 1"}'::jsonb),
    (v_u2, 'm5_student2@example.com', '{"full_name": "M5 Student 2"}'::jsonb);

  UPDATE public.profiles
  SET username = 'm5_student1', full_name = 'M5 Student 1'
  WHERE id = v_u1;

  UPDATE public.profiles
  SET username = 'm5_student2', full_name = 'M5 Student 2'
  WHERE id = v_u2;

  -- Configure routes for User 1 using trusted auth claims
  PERFORM set_config('request.jwt.claims', jsonb_build_object('sub', v_u1, 'role', 'authenticated')::text, true);
  PERFORM set_config('request.jwt.claim.role', 'authenticated', true);
  PERFORM set_config('request.jwt.claim.sub', v_u1::text, true);

  -- 1. Chemistry 9701: AS-only route
  v_us_chem := public.add_subject_enrollment(v_u1, v_subj_chem);
  PERFORM public.configure_subject_route(v_u1, v_us_chem, 'as_only', '[]'::jsonb);
  UPDATE public.user_subjects SET target_grade = 'A' WHERE id = v_us_chem;

  -- 2. Physics 9702: Full A-Level route
  v_us_phys := public.add_subject_enrollment(v_u1, v_subj_phys);
  PERFORM public.configure_subject_route(v_u1, v_us_phys, 'full_level', '[]'::jsonb);
  UPDATE public.user_subjects SET target_grade = 'A*' WHERE id = v_us_phys;

  -- 3. Mathematics 9709: Staged route (Pure 1, Mechanics, Pure 3, Stats 1)
  v_us_math := public.add_subject_enrollment(v_u1, v_subj_math);
  PERFORM public.configure_subject_route(v_u1, v_us_math, 'staged', v_math_selections);
  UPDATE public.user_subjects SET target_grade = 'A*' WHERE id = v_us_math;

  -- Reset auth context
  RESET ROLE;
  PERFORM set_config('request.jwt.claims', '', true);
  PERFORM set_config('request.jwt.claim.role', '', true);
  PERFORM set_config('request.jwt.claim.sub', '', true);

  -- ── 3. Table 1: grade_threshold_import_runs (1 row) ────────────────────────
  INSERT INTO public.grade_threshold_import_runs (
    id,
    trigger_kind,
    parser_version,
    status,
    started_at,
    finished_at,
    aggregate_summary
  ) VALUES (
    '00000000-0000-4000-8000-000000000010',
    'manual',
    '1.0.0',
    'succeeded',

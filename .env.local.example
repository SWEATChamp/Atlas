# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only authentication for the dormant grade-threshold discovery cron endpoint.
# Must be configured by an operator in project environment variables; Vercel supplies it as the Bearer token for cron invocations. Minimum 16 characters.
CRON_SECRET=

# Server-only authentication for the dormant mutating grade-threshold scheduled import endpoint.
# Strictly separate from CRON_SECRET. Minimum 16 characters. Do not prefix with NEXT_PUBLIC_.
GRADE_THRESHOLD_IMPORT_SECRET=

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=A-Level Atlas

# Google OAuth and token storage
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=
